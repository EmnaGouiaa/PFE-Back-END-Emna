package fsegs.pfebackendemnagouuiaa.security;

import fsegs.pfebackendemnagouuiaa.repository.EtudiantRepository;
import fsegs.pfebackendemnagouuiaa.repository.EntrepriseRepository;
import fsegs.pfebackendemnagouuiaa.repository.EncadrantAcademiqueRepository;
import fsegs.pfebackendemnagouuiaa.repository.EncadrantProfessionnelRepository;
import lombok.RequiredArgsConstructor;
import org.springframework.security.core.Authentication;
import org.springframework.stereotype.Component;

@Component("etudiantSecurity")
@RequiredArgsConstructor
public class EtudiantSecurity {

    private final EtudiantRepository etudiantRepository;

    public boolean isOwner(Long etudiantId, Authentication authentication) {
        if (authentication == null || !authentication.isAuthenticated()) {
            return false;
        }

        String email = authentication.getName();
        return etudiantRepository.findById(etudiantId)
                .map(etudiant -> etudiant.getEmail().equals(email))
                .orElse(false);
    }
}

@Component("entrepriseSecurity")
@RequiredArgsConstructor
public class EntrepriseSecurity {

    private final EntrepriseRepository entrepriseRepository;
    private final EncadrantProfessionnelRepository encadrantProfessionnelRepository;

    public boolean isOwner(Long entrepriseId, Authentication authentication) {
        if (authentication == null || !authentication.isAuthenticated()) {
            return false;
        }

        String email = authentication.getName();
        
        // Check if user is a professional supervisor from this company
        return encadrantProfessionnelRepository.findByEmailIgnoreCase(email)
                .map(encadrant -> encadrant.getEntreprise() != null && 
                        encadrant.getEntreprise().getId().equals(entrepriseId))
                .orElse(false);
    }
}

@Component("encadrantSecurity")
@RequiredArgsConstructor
public class EncadrantSecurity {

    private final EncadrantAcademiqueRepository encadrantAcademiqueRepository;
    private final EncadrantProfessionnelRepository encadrantProfessionnelRepository;

    public boolean isOwner(Long encadrantId, Authentication authentication) {
        if (authentication == null || !authentication.isAuthenticated()) {
            return false;
        }

        String email = authentication.getName();
        
        // Check academic supervisor
        if (encadrantAcademiqueRepository.findById(encadrantId)
                .map(encadrant -> encadrant.getEmail().equals(email))
                .orElse(false)) {
            return true;
        }
        
        // Check professional supervisor
        return encadrantProfessionnelRepository.findById(encadrantId)
                .map(encadrant -> encadrant.getEmail().equals(email))
                .orElse(false);
    }
}
