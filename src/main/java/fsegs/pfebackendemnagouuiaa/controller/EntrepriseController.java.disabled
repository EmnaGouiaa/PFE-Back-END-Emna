package fsegs.pfebackendemnagouuiaa.controller;

import fsegs.pfebackendemnagouuiaa.dto.EntrepriseRequestDTO;
import fsegs.pfebackendemnagouuiaa.dto.EntrepriseResponseDTO;
import fsegs.pfebackendemnagouuiaa.services.EntrepriseService;
import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.Parameter;
import io.swagger.v3.oas.annotations.responses.ApiResponse;
import io.swagger.v3.oas.annotations.responses.ApiResponses;
import io.swagger.v3.oas.annotations.tags.Tag;
import jakarta.validation.Valid;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.web.bind.annotation.*;

import java.util.List;

@RestController
@RequestMapping("/api/v1/entreprises")
@RequiredArgsConstructor
@Slf4j
@Tag(name = "Company Management", description = "APIs for managing companies")
@CrossOrigin(origins = {"http://localhost:4200", "http://127.0.0.1:4200"})
public class EntrepriseController {

    private final EntrepriseService entrepriseService;

    @Operation(summary = "Create a new company", description = "Creates a new company. Requires ADMIN role.")
    @ApiResponses(value = {
        @ApiResponse(responseCode = "201", description = "Company created successfully"),
        @ApiResponse(responseCode = "400", description = "Invalid input data"),
        @ApiResponse(responseCode = "409", description = "Company name, email, or telephone already exists"),
        @ApiResponse(responseCode = "403", description = "Access denied")
    })
    @PostMapping
    @PreAuthorize("hasRole('ADMIN')")
    public ResponseEntity<EntrepriseResponseDTO> createEntreprise(
            @Valid @RequestBody EntrepriseRequestDTO requestDTO) {
        log.info("POST /api/v1/entreprises - Creating company: {}", requestDTO.getNom());
        
        EntrepriseResponseDTO response = entrepriseService.createEntreprise(requestDTO);
        return new ResponseEntity<>(response, HttpStatus.CREATED);
    }

    @Operation(summary = "Get company by ID", description = "Retrieves company information by ID. Requires ADMIN, ENCADRANT_PROFESSIONNEL, or RESPONSABLE_ENTREPRISE role.")
    @ApiResponses(value = {
        @ApiResponse(responseCode = "200", description = "Company found"),
        @ApiResponse(responseCode = "404", description = "Company not found"),
        @ApiResponse(responseCode = "403", description = "Access denied")
    })
    @GetMapping("/{id}")
    @PreAuthorize("hasRole('ADMIN') or hasRole('ENCADRANT_PROFESSIONNEL') or hasRole('RESPONSABLE_ENTREPRISE')")
    public ResponseEntity<EntrepriseResponseDTO> getEntrepriseById(
            @Parameter(description = "Company ID") @PathVariable Long id) {
        log.info("GET /api/v1/entreprises/{} - Fetching company", id);
        
        EntrepriseResponseDTO response = entrepriseService.getEntrepriseById(id);
        return ResponseEntity.ok(response);
    }

    @Operation(summary = "Get company by name", description = "Retrieves company information by name. Requires ADMIN role.")
    @ApiResponses(value = {
        @ApiResponse(responseCode = "200", description = "Company found"),
        @ApiResponse(responseCode = "404", description = "Company not found"),
        @ApiResponse(responseCode = "403", description = "Access denied")
    })
    @GetMapping("/nom/{nom}")
    @PreAuthorize("hasRole('ADMIN')")
    public ResponseEntity<EntrepriseResponseDTO> getEntrepriseByNom(
            @Parameter(description = "Company name") @PathVariable String nom) {
        log.info("GET /api/v1/entreprises/nom/{} - Fetching company", nom);
        
        EntrepriseResponseDTO response = entrepriseService.getEntrepriseByNom(nom);
        return ResponseEntity.ok(response);
    }

    @Operation(summary = "Get all companies", description = "Retrieves all companies. Requires ADMIN, ENCADRANT_ACADEMIQUE, or ENCADRANT_PROFESSIONNEL role.")
    @ApiResponses(value = {
        @ApiResponse(responseCode = "200", description = "Companies retrieved successfully"),
        @ApiResponse(responseCode = "403", description = "Access denied")
    })
    @GetMapping
    @PreAuthorize("hasRole('ADMIN') or hasRole('ENCADRANT_ACADEMIQUE') or hasRole('ENCADRANT_PROFESSIONNEL')")
    public ResponseEntity<List<EntrepriseResponseDTO>> getAllEntreprises() {
        log.info("GET /api/v1/entreprises - Fetching all companies");
        
        List<EntrepriseResponseDTO> response = entrepriseService.getAllEntreprises();
        return ResponseEntity.ok(response);
    }

    @Operation(summary = "Update company", description = "Updates company information. Requires ADMIN or company manager role.")
    @ApiResponses(value = {
        @ApiResponse(responseCode = "200", description = "Company updated successfully"),
        @ApiResponse(responseCode = "404", description = "Company not found"),
        @ApiResponse(responseCode = "409", description = "Company name, email, or telephone already exists"),
        @ApiResponse(responseCode = "403", description = "Access denied")
    })
    @PutMapping("/{id}")
    @PreAuthorize("hasRole('ADMIN') or (hasRole('RESPONSABLE_ENTREPRISE') and @entrepriseSecurity.isOwner(#id, authentication))")
    public ResponseEntity<EntrepriseResponseDTO> updateEntreprise(
            @Parameter(description = "Company ID") @PathVariable Long id,
            @Valid @RequestBody EntrepriseRequestDTO requestDTO) {
        log.info("PUT /api/v1/entreprises/{} - Updating company", id);
        
        EntrepriseResponseDTO response = entrepriseService.updateEntreprise(id, requestDTO);
        return ResponseEntity.ok(response);
    }

    @Operation(summary = "Delete company", description = "Deletes a company. Requires ADMIN role.")
    @ApiResponses(value = {
        @ApiResponse(responseCode = "204", description = "Company deleted successfully"),
        @ApiResponse(responseCode = "404", description = "Company not found"),
        @ApiResponse(responseCode = "400", description = "Cannot delete company with active internships or assigned personnel"),
        @ApiResponse(responseCode = "403", description = "Access denied")
    })
    @DeleteMapping("/{id}")
    @PreAuthorize("hasRole('ADMIN')")
    public ResponseEntity<Void> deleteEntreprise(
            @Parameter(description = "Company ID") @PathVariable Long id) {
        log.info("DELETE /api/v1/entreprises/{} - Deleting company", id);
        
        entrepriseService.deleteEntreprise(id);
        return ResponseEntity.noContent().build();
    }

    @Operation(summary = "Get companies by sector", description = "Retrieves companies by sector of activity. Requires ADMIN, ENCADRANT_ACADEMIQUE, or ENCADRANT_PROFESSIONNEL role.")
    @ApiResponses(value = {
        @ApiResponse(responseCode = "200", description = "Companies retrieved successfully"),
        @ApiResponse(responseCode = "403", description = "Access denied")
    })
    @GetMapping("/secteur/{secteur}")
    @PreAuthorize("hasRole('ADMIN') or hasRole('ENCADRANT_ACADEMIQUE') or hasRole('ENCADRANT_PROFESSIONNEL')")
    public ResponseEntity<List<EntrepriseResponseDTO>> getEntreprisesBySecteur(
            @Parameter(description = "Sector of activity") @PathVariable String secteur) {
        log.info("GET /api/v1/entreprises/secteur/{} - Fetching companies by sector", secteur);
        
        List<EntrepriseResponseDTO> response = entrepriseService.getEntreprisesBySecteur(secteur);
        return ResponseEntity.ok(response);
    }

    @Operation(summary = "Search companies", description = "Searches companies by keyword in name or sector. Requires ADMIN, ENCADRANT_ACADEMIQUE, or ENCADRANT_PROFESSIONNEL role.")
    @ApiResponses(value = {
        @ApiResponse(responseCode = "200", description = "Companies retrieved successfully"),
        @ApiResponse(responseCode = "403", description = "Access denied")
    })
    @GetMapping("/search")
    @PreAuthorize("hasRole('ADMIN') or hasRole('ENCADRANT_ACADEMIQUE') or hasRole('ENCADRANT_PROFESSIONNEL')")
    public ResponseEntity<List<EntrepriseResponseDTO>> searchEntreprises(
            @Parameter(description = "Search keyword") @RequestParam String keyword) {
        log.info("GET /api/v1/entreprises/search?keyword={} - Searching companies", keyword);
        
        List<EntrepriseResponseDTO> response = entrepriseService.searchEntreprises(keyword);
        return ResponseEntity.ok(response);
    }

    @Operation(summary = "Get company statistics", description = "Retrieves company statistics. Requires ADMIN role.")
    @ApiResponses(value = {
        @ApiResponse(responseCode = "200", description = "Statistics retrieved successfully"),
        @ApiResponse(responseCode = "403", description = "Access denied")
    })
    @GetMapping("/stats")
    @PreAuthorize("hasRole('ADMIN')")
    public ResponseEntity<EntrepriseService.EntrepriseStatsDTO> getEntrepriseStats() {
        log.info("GET /api/v1/entreprises/stats - Fetching company statistics");
        
        EntrepriseService.EntrepriseStatsDTO response = entrepriseService.getEntrepriseStats();
        return ResponseEntity.ok(response);
    }
}
