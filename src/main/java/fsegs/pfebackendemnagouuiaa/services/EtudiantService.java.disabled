package fsegs.pfebackendemnagouuiaa.services;

import fsegs.pfebackendemnagouuiaa.dto.EtudiantRequestDTO;
import fsegs.pfebackendemnagouuiaa.dto.EtudiantResponseDTO;
import fsegs.pfebackendemnagouuiaa.entities.Etudiant;
import fsegs.pfebackendemnagouuiaa.entities.Role;
import fsegs.pfebackendemnagouuiaa.repository.EtudiantRepository;
import fsegs.pfebackendemnagouuiaa.repository.UserRepository;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.util.List;
import java.util.stream.Collectors;

@Service
@RequiredArgsConstructor
@Slf4j
@Transactional
public class EtudiantService {

    private final EtudiantRepository etudiantRepository;
    private final UserRepository userRepository;
    private final PasswordEncoder passwordEncoder;

    /**
     * Create a new student
     */
    public EtudiantResponseDTO createEtudiant(EtudiantRequestDTO requestDTO) {
        log.info("Creating new student with email: {}", requestDTO.getEmail());

        // Check if email already exists
        if (userRepository.findByEmailIgnoreCase(requestDTO.getEmail()).isPresent()) {
            throw new RuntimeException("Email already exists: " + requestDTO.getEmail());
        }

        // Check if matricule already exists
        if (etudiantRepository.findByMatriculeIgnoreCase(requestDTO.getMatricule()).isPresent()) {
            throw new RuntimeException("Matricule already exists: " + requestDTO.getMatricule());
        }

        Etudiant etudiant = Etudiant.builder()
                .prenom(requestDTO.getPrenom())
                .nom(requestDTO.getNom())
                .email(requestDTO.getEmail())
                .password(passwordEncoder.encode(requestDTO.getPassword()))
                .matricule(requestDTO.getMatricule())
                .filiere(requestDTO.getFiliere())
                .niveau(requestDTO.getNiveau())
                .niveauStage(requestDTO.getNiveauStage())
                .telephone(requestDTO.getTelephone())
                .adresse(requestDTO.getAdresse())
                .role(Role.STAGIAIRE)
                .compteValide(false) // Requires admin validation
                .build();

        Etudiant savedEtudiant = etudiantRepository.save(etudiant);
        log.info("Student created successfully with ID: {}", savedEtudiant.getId());

        return EtudiantResponseDTO.fromEntity(savedEtudiant);
    }

    /**
     * Get student by ID
     */
    @Transactional(readOnly = true)
    public EtudiantResponseDTO getEtudiantById(Long id) {
        log.info("Fetching student with ID: {}", id);
        
        Etudiant etudiant = etudiantRepository.findById(id)
                .orElseThrow(() -> new RuntimeException("Student not found with ID: " + id));

        return EtudiantResponseDTO.fromEntity(etudiant);
    }

    /**
     * Get student by matricule
     */
    @Transactional(readOnly = true)
    public EtudiantResponseDTO getEtudiantByMatricule(String matricule) {
        log.info("Fetching student with matricule: {}", matricule);
        
        Etudiant etudiant = etudiantRepository.findByMatriculeIgnoreCase(matricule)
                .orElseThrow(() -> new RuntimeException("Student not found with matricule: " + matricule));

        return EtudiantResponseDTO.fromEntity(etudiant);
    }

    /**
     * Get all students
     */
    @Transactional(readOnly = true)
    public List<EtudiantResponseDTO> getAllEtudiants() {
        log.info("Fetching all students");
        
        List<Etudiant> etudiants = etudiantRepository.findAll();
        return etudiants.stream()
                .map(EtudiantResponseDTO::fromEntity)
                .collect(Collectors.toList());
    }

    /**
     * Update student
     */
    public EtudiantResponseDTO updateEtudiant(Long id, EtudiantRequestDTO requestDTO) {
        log.info("Updating student with ID: {}", id);

        Etudiant existingEtudiant = etudiantRepository.findById(id)
                .orElseThrow(() -> new RuntimeException("Student not found with ID: " + id));

        // Check if email is being changed and if new email already exists
        if (!existingEtudiant.getEmail().equalsIgnoreCase(requestDTO.getEmail()) &&
            userRepository.findByEmailIgnoreCase(requestDTO.getEmail()).isPresent()) {
            throw new RuntimeException("Email already exists: " + requestDTO.getEmail());
        }

        // Check if matricule is being changed and if new matricule already exists
        if (!existingEtudiant.getMatricule().equalsIgnoreCase(requestDTO.getMatricule()) &&
            etudiantRepository.findByMatriculeIgnoreCase(requestDTO.getMatricule()).isPresent()) {
            throw new RuntimeException("Matricule already exists: " + requestDTO.getMatricule());
        }

        existingEtudiant.setPrenom(requestDTO.getPrenom());
        existingEtudiant.setNom(requestDTO.getNom());
        existingEtudiant.setEmail(requestDTO.getEmail());
        if (requestDTO.getPassword() != null && !requestDTO.getPassword().trim().isEmpty()) {
            existingEtudiant.setPassword(passwordEncoder.encode(requestDTO.getPassword()));
        }
        existingEtudiant.setMatricule(requestDTO.getMatricule());
        existingEtudiant.setFiliere(requestDTO.getFiliere());
        existingEtudiant.setNiveau(requestDTO.getNiveau());
        existingEtudiant.setNiveauStage(requestDTO.getNiveauStage());
        existingEtudiant.setTelephone(requestDTO.getTelephone());
        existingEtudiant.setAdresse(requestDTO.getAdresse());

        Etudiant updatedEtudiant = etudiantRepository.save(existingEtudiant);
        log.info("Student updated successfully with ID: {}", updatedEtudiant.getId());

        return EtudiantResponseDTO.fromEntity(updatedEtudiant);
    }

    /**
     * Delete student
     */
    public void deleteEtudiant(Long id) {
        log.info("Deleting student with ID: {}", id);

        Etudiant etudiant = etudiantRepository.findById(id)
                .orElseThrow(() -> new RuntimeException("Student not found with ID: " + id));

        // Check if student has active internships
        if (etudiant.getStages() != null && !etudiant.getStages().isEmpty()) {
            boolean hasActiveStages = etudiant.getStages().stream()
                    .anyMatch(stage -> stage.getType() != null && 
                            (stage.getType().name().equals("EN_COURS") || stage.getType().name().equals("PLANIFIE")));
            if (hasActiveStages) {
                throw new RuntimeException("Cannot delete student with active internships");
            }
        }

        etudiantRepository.delete(etudiant);
        log.info("Student deleted successfully with ID: {}", id);
    }

    /**
     * Validate student account
     */
    public EtudiantResponseDTO validateEtudiantAccount(Long id) {
        log.info("Validating student account with ID: {}", id);

        Etudiant etudiant = etudiantRepository.findById(id)
                .orElseThrow(() -> new RuntimeException("Student not found with ID: " + id));

        etudiant.setCompteValide(true);
        Etudiant validatedEtudiant = etudiantRepository.save(etudiant);
        log.info("Student account validated successfully with ID: {}", id);

        return EtudiantResponseDTO.fromEntity(validatedEtudiant);
    }

    /**
     * Get students by filiere
     */
    @Transactional(readOnly = true)
    public List<EtudiantResponseDTO> getEtudiantsByFiliere(String filiere) {
        log.info("Fetching students by filiere: {}", filiere);
        
        List<Etudiant> etudiants = etudiantRepository.findByFiliere(filiere);
        return etudiants.stream()
                .map(EtudiantResponseDTO::fromEntity)
                .collect(Collectors.toList());
    }

    /**
     * Get students by niveau
     */
    @Transactional(readOnly = true)
    public List<EtudiantResponseDTO> getEtudiantsByNiveau(String niveau) {
        log.info("Fetching students by niveau: {}", niveau);
        
        List<Etudiant> etudiants = etudiantRepository.findByNiveau(niveau);
        return etudiants.stream()
                .map(EtudiantResponseDTO::fromEntity)
                .collect(Collectors.toList());
    }

    /**
     * Search students by keyword
     */
    @Transactional(readOnly = true)
    public List<EtudiantResponseDTO> searchEtudiants(String keyword) {
        log.info("Searching students with keyword: {}", keyword);
        
        List<Etudiant> etudiants = etudiantRepository.findAll().stream()
                .filter(e -> e.getPrenom().toLowerCase().contains(keyword.toLowerCase()) ||
                        e.getNom().toLowerCase().contains(keyword.toLowerCase()) ||
                        e.getEmail().toLowerCase().contains(keyword.toLowerCase()) ||
                        e.getMatricule().toLowerCase().contains(keyword.toLowerCase()) ||
                        (e.getFiliere() != null && e.getFiliere().toLowerCase().contains(keyword.toLowerCase())))
                .collect(Collectors.toList());

        return etudiants.stream()
                .map(EtudiantResponseDTO::fromEntity)
                .collect(Collectors.toList());
    }
}
