package fsegs.pfebackendemnagouuiaa.dto;

import jakarta.validation.constraints.Email;
import jakarta.validation.constraints.NotBlank;
import jakarta.validation.constraints.Size;
import lombok.AllArgsConstructor;
import lombok.Builder;
import lombok.Data;
import lombok.NoArgsConstructor;

@Data
@Builder
@NoArgsConstructor
@AllArgsConstructor
public class EtudiantRequestDTO {
    
    @NotBlank(message = "First name is required")
    @Size(max = 50, message = "First name must not exceed 50 characters")
    private String prenom;
    
    @NotBlank(message = "Last name is required")
    @Size(max = 50, message = "Last name must not exceed 50 characters")
    private String nom;
    
    @NotBlank(message = "Email is required")
    @Email(message = "Email should be valid")
    @Size(max = 100, message = "Email must not exceed 100 characters")
    private String email;
    
    @NotBlank(message = "Password is required")
    @Size(min = 6, message = "Password must be at least 6 characters")
    private String password;
    
    @NotBlank(message = "Matricule is required")
    @Size(max = 20, message = "Matricule must not exceed 20 characters")
    private String matricule;
    
    @Size(max = 100, message = "Filiere must not exceed 100 characters")
    private String filiere;
    
    @Size(max = 50, message = "Niveau must not exceed 50 characters")
    private String niveau;
    
    @Size(max = 50, message = "Niveau stage must not exceed 50 characters")
    private String niveauStage;
    
    @Size(max = 20, message = "Telephone must not exceed 20 characters")
    private String telephone;
    
    @Size(max = 200, message = "Address must not exceed 200 characters")
    private String adresse;
}
